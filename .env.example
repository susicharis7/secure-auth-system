# General
PORT=3000
NODE_ENV=development
BACKEND_PUBLIC_BASE_URL=http://localhost:3000
VITE_HCAPTCHA_SITE_KEY=

REQUEST_BIN_URL=...

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Text messages
TEXT_MESSAGE_API_KEY=
TEXT_MESSAGE_SECRET=
TEXT_MESSAGE_BASE_URL=
INFOBIP_SMS_PATH=/sms/3/messages
INFOBIP_SENDER=ServiceSMS
INFOBIP_DESTINATION=+3876XXXXXXX

# Mailing
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Captcha
HCAPTCHA_SERVER_SECRET=
HCAPTCHA_SITE_KEY=

# JWT
JWT_ACCESS_SECRET=replace_with_random_32_plus_character_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_random_32_plus_character_refresh_secret
JWT_REFRESH_TTL=7d

# Cookies
AUTH_COOKIE_NAME=auth_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

REFRESH_COOKIE_NAME=auth_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Abuse protection
CAPTCHA_LOGIN_MAX_FAILED_ATTEMPTS=3
CAPTCHA_PASSWORD_RESET_MAX_FAILED_ATTEMPTS=2
CAPTCHA_PASSWORD_RESET_WINDOW_MINUTES=10

# Rate limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_LIMIT=100

RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_LIMIT=10

RATE_LIMIT_REFRESH_WINDOW_MS=60000
RATE_LIMIT_REFRESH_LIMIT=30

RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_MS=60000
RATE_LIMIT_PASSWORD_RESET_REQUEST_LIMIT=10

RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW_MS=60000
RATE_LIMIT_PASSWORD_RESET_CONFIRM_LIMIT=10

RATE_LIMIT_2FA_VERIFY_WINDOW_MS=60000
RATE_LIMIT_2FA_VERIFY_LIMIT=20

RATE_LIMIT_SSO_WINDOW_MS=60000
RATE_LIMIT_SSO_LIMIT=20

# Security alerts
SECURITY_ALERTS_ENABLED=true

ALERT_CREDENTIAL_STUFFING_THRESHOLD=5
ALERT_CREDENTIAL_STUFFING_WINDOW_MINUTES=1

ALERT_BRUTE_FORCE_THRESHOLD=10
ALERT_BRUTE_FORCE_WINDOW_MINUTES=1

ALERT_COORDINATED_ABUSE_THRESHOLD=20
ALERT_COORDINATED_ABUSE_WINDOW_MINUTES=5

ALERT_PRIVILEGE_ESCALATION_THRESHOLD=3
ALERT_PRIVILEGE_ESCALATION_WINDOW_MINUTES=5

ALERT_COOLDOWN_MINUTES=5